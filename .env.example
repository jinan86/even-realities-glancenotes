# GlanceNotes backend config. Copy to .env (never commit .env).
# All secrets stay server-side; the glasses app and companion page never
# see a token or key.

# Notion adapter: mock (sample data, no token) or live (real Notion).
NOTION_ADAPTER=mock
# Live adapter only (leave blank until zee provides the token via Secure Vault):
NOTION_TOKEN=
NOTION_TASKS_DB_ID=

# Backend port (the G2 app calls http://localhost:3001).
PORT=3001

# LLM chain (optional — leave blank to use the Secure Vault surrogate;
# without any key the heuristic fallback still answers from your notes).
# LLM_API_KEY=        100milionseek
# LLM2_API_KEY=       OpenRouter
# LLM3_API_KEY=       Coarena
